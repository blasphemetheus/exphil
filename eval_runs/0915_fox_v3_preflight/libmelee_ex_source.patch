diff --git a/test/melee/integration/mewtwo_tech_test.exs b/test/melee/integration/mewtwo_tech_test.exs
index 129aa93..ad5a0a3 100644
--- a/test/melee/integration/mewtwo_tech_test.exs
+++ b/test/melee/integration/mewtwo_tech_test.exs
@@ -38,6 +38,61 @@ defmodule Melee.Integration.MewtwoTechTest do
     end
   end
 
+  @tag :mewtwo_neutral_execution
+  test "neutral movement: short hops and wavedashes in both directions", ctx do
+    refute ctx[:skip], "Live teacher validation requires Dolphin and an ISO"
+    probe = boot(ctx)
+
+    try do
+      probe = Probe.idle!(probe, 90)
+      {probe, short} = hop_peak(probe, :short_hop)
+      {probe, full} = hop_peak(probe, :full_hop)
+      assert short > 1.0
+      assert full > short * 1.5
+
+      {probe, trials} = Enum.reduce(1..8, {probe, []}, fn i, {p, trials} ->
+        p = settle(p) |> Probe.idle!(30)
+        direction = if rem(i, 2) == 1, do: :right, else: :left
+        x = Probe.gamestate(p).players[1].position.x
+        {p, landed} = run_tech(p, Tech.new(:wavedash, :mewtwo, direction: direction),
+          90, fn acc, player -> acc or player.action == Enums.Action.to_id(:landing_special) end, false)
+        Melee.Controller.release_all(p.controllers[1])
+        p = Probe.idle!(p, 30)
+        delta = Probe.gamestate(p).players[1].position.x - x
+        assert landed
+        assert if(direction == :right, do: delta > 5.0, else: delta < -5.0)
+        {p, trials ++ [%{direction: direction, displacement: delta}]}
+      end)
+
+      IO.puts("[mewtwo teacher] short/full apex=#{inspect({short, full})} wavedashes=#{inspect(trials)}")
+
+      Enum.reduce([:nair, :fair], probe, fn aerial, p ->
+        p = settle(p) |> Probe.idle!(30)
+        {p, actions} = run_tech(p, Tech.new(:shffl, :mewtwo, aerial: aerial),
+          180, fn actions, player -> MapSet.put(actions, player.action) end, MapSet.new())
+        assert MapSet.member?(actions, Enums.Action.to_id(aerial))
+        landing = if aerial == :nair, do: :nair_landing, else: :fair_landing
+        assert MapSet.member?(actions, Enums.Action.to_id(landing))
+        IO.puts("[mewtwo teacher] #{aerial}: aerial and landing observed; actions=#{inspect(MapSet.to_list(actions))}")
+        Melee.Controller.release_all(p.controllers[1])
+        p
+      end)
+    after
+      Probe.stop(probe)
+    end
+  end
+
+  defp hop_peak(probe, routine) do
+    probe = settle(probe) |> Probe.idle!(30)
+    {probe, apex} = run_tech(probe, Tech.new(routine, :mewtwo), 90,
+      fn apex, player -> max(apex, player.position.y) end, 0.0)
+    Melee.Controller.release_all(probe.controllers[1])
+    Enum.reduce(1..120, {probe, apex}, fn _, {p, apex} ->
+      p = Probe.step!(p)
+      {p, max(apex, Probe.gamestate(p).players[1].position.y)}
+    end)
+  end
+
   test "DJC nair, shadow ball store + fire, teledgehog", ctx do
