+// experiment: names of compare specs whose source column the recording lacks
+static char g_skip_specs[32][40];
+static int g_n_skip = 0;
+static uint8_t g_zero_column[1 << 20]; // zero stand-in for an absent column
+static void skip_spec(const char* name) {
+  for (int i = 0; i < g_n_skip; ++i) if (strcmp(g_skip_specs[i], name) == 0) return;
+  if (g_n_skip < 32) { strncpy(g_skip_specs[g_n_skip], name, 39); g_skip_specs[g_n_skip][39] = 0; g_n_skip++; }
+}
+static int spec_skipped(const char* name) {
+  for (int i = 0; i < g_n_skip; ++i) if (strcmp(g_skip_specs[i], name) == 0) return 1;
+  return 0;
+}
+static int optional_era_field(ArrowNode parent, const char* name, const char* format, Primitive* target,
+                              const char* spec_name, char* error, size_t error_size) {
+  if (primitive_child(parent, name, format, target, error, error_size) == 0) return 0;
+  if (getenv("MSL_DECLARED_SCENE_MAJOR") == NULL) return -1;
+  error[0] = 0;
+  target->validity = NULL;
+  target->data = g_zero_column;
+  target->offset = 0;
+  skip_spec(spec_name);
+  return 0;
+}
