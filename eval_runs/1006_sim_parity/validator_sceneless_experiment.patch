+// FrameStart seed, or (sceneless experiment) the first present player's
+// pre-frame seed when the recording predates FrameStart events.
+static uint32_t frame_seed_at(const ReplayView* replay, const FrameRows* rows, int64_t logical_pos) {
+  if (!replay->frame_seed_missing) {
+    return get_u32(&replay->frame_seed, rows->raw[logical_pos]);
+  }
+  for (int player = 0; player < replay->num_players; ++player) {
+    if (rows->player_present[player][logical_pos]) {
+      return get_u32(&replay->players[player].random_seed, rows->player_raw[player][logical_pos]);
+    }
+  }
+  return 0;
+}
