+// Reads the snapshot latched by D9, never drains or waits for another frame.
+void CEXISlippi::prepareOverwriteProcessedInputs()
+{
+	m_read_queue.clear();
+	for (int port = 1; port <= 4; ++port)
+	{
+		u8 data[40] = {};
+		bool enabled = SConfig::GetInstance().m_slippiDirectInputs &&
+		    SlippiSpectateServer::getInstance()->directProcessedPad(port, data);
+		appendWordToBuffer(&m_read_queue, enabled ? 1 : 0);
+		m_read_queue.insert(m_read_queue.end(), data, data + 40);
+	}
+}
