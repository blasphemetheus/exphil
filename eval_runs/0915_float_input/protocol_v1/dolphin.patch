+bool SlippiSpectateServer::directProcessedPad(int port, u8 *out)
+{
+	if (m_direct_fd.load(std::memory_order_acquire) < 0 || port < 1 || port > 4 ||
+	    !m_direct_mixed || m_direct_frame.mode[port - 1] != 2) return false;
